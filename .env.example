# Owner login (generate these with: npm run setup:admin -- <email> <password>)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Local SQLite fallback (ignored on Vercel when DATABASE_URL is set)
AAS_DATABASE_PATH=./data/shop.sqlite

# Neon PostgreSQL (pooled connection for the running app)
DATABASE_URL=

# Neon PostgreSQL (direct connection for migration scripts only)
DIRECT_URL=

# Vercel Blob (persistent product images)
BLOB_READ_WRITE_TOKEN=

# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY_HEADERS=0
